# Frontend service environment (~/.config/clinpath/frontend.env on the VPS).
# The web tier must never receive model credentials.
#
#   install -m 600 deploy/env/frontend.env.example ~/.config/clinpath/frontend.env
#   # then set JWT_SECRET to the same value the backend uses

# Same value as the backend. proxy.ts verifies cookie signatures with it and
# refuses to trust unverified role claims: without it a token-bearing request is
# answered with 503 rather than being let through.
JWT_SECRET=

INTERNAL_API_BASE_URL=http://127.0.0.1:8100/api

# Public UI flags. Showing the restricted student demo account is optional; the
# register link must stay hidden while ALLOW_PUBLIC_REGISTRATION is false.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false

# Optional: stamped automatically from git at build time when left empty.
NEXT_PUBLIC_BUILD_SHA=
