# Backend service environment (~/.config/clinpath/backend.env on the VPS).
# Placeholders only - never commit real credentials.
#
#   install -m 600 deploy/env/backend.env.example ~/.config/clinpath/backend.env
#   # then fill in JWT_SECRET and LLM_API_KEY with real values

CLINPATH_ENV=production

# Required in production: the backend signs JWTs with this and the Next proxy
# verifies them with the same value (see deploy/env/frontend.env.example).
JWT_SECRET=

# Set to true only when the public entry is HTTPS. The pilot entry is
# https://clinpath.1031989.xyz, so this is true in production: a Secure cookie is
# not stored by the browser over plain HTTP, which is the intended fail-closed
# behaviour once 8101 is no longer public.
COOKIE_SECURE=true

# Anonymous self-registration spends paid model quota; keep it closed in public.
ALLOW_PUBLIC_REGISTRATION=false

# Staff accounts are never seeded: provision them locally with
#   python -m app.manage_users create-teacher <username> --teacher-no <no>
#   python -m app.manage_users create-admin <username>

FRONTEND_ORIGINS=http://127.0.0.1:8101

# Canonical LLM configuration (deprecated DEEPSEEK_*/OPENAI_* aliases still work).
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
# Thinking Mode spends ~3k tokens on the reasoning trace before the answer, so a
# 4096 budget can truncate a JSON body. Measured live, see docs/ARCH.md §5.1.1.
LLM_MAX_TOKENS=8192

# Worker processes. Read endpoints are synchronous, so this is the difference
# between "one request of Python work at a time" and a usable pilot.
# 0 means "one process"; 4 was measured to hold 100 concurrent readers at
# p95 ~0.19s on a 4 vCPU box. The in-memory rate limiter and ai_runtime counters
# become per-process when this is > 1 (docs/ARCH.md §12).
CLINPATH_BACKEND_WORKERS=4

# SQLite connection pool: the default (5 + 10 overflow) was the real ceiling at
# 100 concurrent readers, not SQLite itself. See docs/PILOT_READINESS_REPORT.md.
CLINPATH_SQLITE_POOL_SIZE=20
CLINPATH_SQLITE_MAX_OVERFLOW=40
CLINPATH_SQLITE_POOL_TIMEOUT=5

# AI enrichment (explanation wording cached behind the read path). "off" stops
# all such provider calls immediately; reads keep working on rule reasons.
CLINPATH_AI_ENRICHMENT=on

# Abuse protection (per identity, sliding window).
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_LOGIN_PER_HOUR=60
MAX_COACH_TURNS_PER_SESSION=20
MAX_TUTOR_TURNS_PER_STEP=6
MAX_SP_MESSAGES_PER_SESSION=40

# Reject (instead of warn about) case text that looks like it carries patient
# identifiers.
REQUIRE_CASE_DEIDENTIFICATION=false

# Only for a disposable/demo deployment: enable the restricted student demo
# logins and set their password explicitly.
SEED_DEMO_STUDENT_ACCOUNTS=true
SEED_DEMO_STUDENT_PASSWORD=
