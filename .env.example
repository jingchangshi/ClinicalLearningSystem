# Local development template. Placeholders only - never commit real credentials.
#
# For the deployed services use the split templates instead:
#   deploy/env/backend.env.example   -> ~/.config/clinpath/backend.env
#   deploy/env/frontend.env.example  -> ~/.config/clinpath/frontend.env

CLINPATH_ENV=development

# The backend signs JWTs and the Next proxy verifies them: both need the same
# value locally too.
JWT_SECRET=dev-only-change-me
COOKIE_SECURE=false
ACCESS_TOKEN_EXPIRE_HOURS=12

ALLOW_PUBLIC_REGISTRATION=true
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8101,http://127.0.0.1:8101
INTERNAL_API_BASE_URL=http://127.0.0.1:8100/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=true

# Canonical LLM configuration. Leave LLM_API_KEY empty to run the rule-based
# fallback path with an explicitly degraded evaluation mode.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=2

SEED_DEMO_STUDENT_ACCOUNTS=true
SEED_DEMO_STUDENT_PASSWORD=student123
